{
  "name": "nebo-dash-publication",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "npm run build && wrangler dev --env local --port 8790",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "wrangler types && tsc --noEmit",
    "deploy": "npm run build && node tools/preflight.mjs && wrangler deploy",
    "test:integration": "node tools/integration.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}